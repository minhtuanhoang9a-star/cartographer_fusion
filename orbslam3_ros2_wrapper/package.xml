<?xml version="1.0"?>
<package format="3">
  <name>orbslam3_ros2_wrapper</name>
  <version>0.1.0</version>
  <description>ROS 2 adapter for ORB-SLAM3.</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visual_constraint_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>sophus</depend>
  <!-- Chỉ cần cho real mode (USE_MOCK_ORBSLAM3=OFF). Bật lại khi orbslam3_core
       đã build/install được:
  <depend>orbslam3_core</depend>
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>